<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Deal Desk User</label>
    <description>Deal Desk demo: gives sales reps the Deal Desk app and Deal Desk Agent, lets them read and update the Deal Desk fields on Opportunity, and run the Review Deal Discount action (Agent Fabric broker).</description>
    <hasActivationRequired>false</hasActivationRequired>
    <agentAccesses>
        <agentName>DD_Deal_Desk_Agent</agentName>
        <enabled>true</enabled>
    </agentAccesses>
    <applicationVisibilities>
        <application>DD_Deal_Desk</application>
        <visible>true</visible>
    </applicationVisibilities>
    <classAccesses>
        <apexClass>DD_ReviewDealDiscountAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <fieldPermissions>
        <editable>true</editable>
        <field>Opportunity.DD_Contract_Draft_Id__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Opportunity.DD_Deal_Desk_Summary__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Opportunity.DD_Deal_ID__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Opportunity.DD_Decision__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Opportunity.DD_Requested_Discount__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Opportunity</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
</PermissionSet>
